{
  "expo": {
    "name": "AxtarIS",
    "slug": "axtaris",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "axtaris",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/axtaris_splash_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "az.axtaris.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "AxtarIS uses the local network only during development to connect to developer tools. It is not used in normal app usage."
      }
    },
    "android": {
      "package": "az.axtaris.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/axtaris_splash_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/axtaris_splash_logo.png",
            "backgroundColor": "#0A1628"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "AxtarIS uses your photo library so you can set a profile picture, company logo, or share an image in chat.",
          "cameraPermission": "AxtarIS uses your camera so you can take a profile picture or company logo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2D4797"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "axtaris",
          "project": "axtaris-app",
          "url": "https://sentry.io/"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa03aa4f-d500-4e59-a339-8df137c8a1e6"
      }
    }
  }
}
